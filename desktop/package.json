{
  "name": "carbonfibre-desktop",
  "productName": "CarbonFibre",
  "version": "1.0.0",
  "description": "CarbonFibre local notes, as a desktop app",
  "author": "CarbonFibre",
  "homepage": "https://github.com/zacgozx/CarbonFibre",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "page": "node build-page.js",
    "start": "node build-page.js && electron .",
    "dist": "node build-page.js && electron-builder --publish never",
    "dist:mac": "node build-page.js && electron-builder --mac --publish never",
    "dist:win": "node build-page.js && electron-builder --win --publish never",
    "dist:linux": "node build-page.js && electron-builder --linux --publish never",
    "test": "node build-page.js && electron test/run.js && electron test/node_test.js && electron test/db_test.js && electron test/update_test.js",
    "icons": "electron build-icons.js"
  },
  "build": {
    "appId": "io.github.carbonfibre.desktop",
    "productName": "CarbonFibre",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "db.js",
      "updater.js",
      "preload.js",
      "prompt-preload.js",
      "prompt.html",
      "prompt.js",
      "plugins/*.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "page/index.html",
        "to": "page/index.html"
      },
      {
        "from": "page/vendor",
        "to": "page/vendor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CarbonFibre-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CarbonFibre-win-${arch}-setup.${ext}"
    },
    "linux": {
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "CarbonFibre",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "plugins/analyze-worker.js",
      "plugins/compat.js"
    ],
    "appImage": {
      "artifactName": "CarbonFibre-linux-${arch}.${ext}"
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "moment": "2.30.1"
  }
}
